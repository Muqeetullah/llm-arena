{
  "name": "llm-arena",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "precommit": "npm run typecheck && lint-staged",
    "prepare": "simple-git-hooks",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "prisma:generate": "prisma generate"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run precommit"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,jsonc,md,mdx,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.239",
    "@arcjet/next": "^1.9.1",
    "@clerk/nextjs": "^7.7.1",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@posthog/ai": "^8.7.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "6.0.237",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "posthog-js": "^1.414.0",
    "posthog-node": "^5.48.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
